# The contact form's two settings. Copy to `.env` for local work, and set the
# same names in the Vercel project for production.
#
# RESEND_API_KEY is a SECRET. It never reaches the browser: /api/contact is the
# only server-rendered route on the site and the call to Resend is made there.
# A key in client JavaScript is a key anyone can send mail with.
RESEND_API_KEY=

# The private inbox that receives contact-form submissions. This address is not
# rendered on the public contact page; hello@openconvert.dev remains the public
# address and can forward here separately.
CONTACT_TO=blasiofabrizio23@gmail.com

# The From: address. Resend requires a verified domain, so until
# openconvert.dev is verified in the Resend dashboard leave this unset — the
# route falls back to onboarding@resend.dev, which Resend allows and which can
# only deliver to the account owner's own address.
CONTACT_FROM=OpenConvert <hello@openconvert.dev>
