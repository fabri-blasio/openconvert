---
// A5 — NOTHING OVERWRITTEN. (10-WEBSITE §7)
//
// Two columns, same archive, opposite outcomes. An archive member named after a
// file you already have passes every traversal check ever written — correctly,
// because it is not traversal. Left: the originals are replaced. Right: they are
// untouched and the new files land beside them with a suffix.
//
// This is structural rather than a setting: every create is O_EXCL / CREATE_NEW,
// no truncating open exists in the codebase, and a source scan fails the build
// if one appears.
const members = ['.bashrc', 'id_rsa', 'resume.docx', 'Thumbs.db'];
---
<div class="ow-grid">
  <figure class="panel ow">
    <div class="rec-bar">
      <span class="rec-label">a typical extractor</span>
      <span class="rec-label ow-bad">4 files replaced</span>
    </div>
    <div class="panel-body">
      <ol class="ow-list">
        {members.map((m, i) => (
          <li class="ow-row seq" style={`animation-delay: ${240 + i * 420}ms`}>
            <code class="ow-name ow-gone">{m}</code>
            <span class="ow-note">truncated on open · previous contents gone</span>
          </li>
        ))}
      </ol>
    </div>
  </figure>

  <figure class="panel ow">
    <div class="rec-bar">
      <span class="rec-label">openconvert</span>
      <span class="rec-label ow-good">4 files added</span>
    </div>
    <div class="panel-body">
      <ol class="ow-list">
        {members.map((m, i) => (
          <li class="ow-row seq" style={`animation-delay: ${450 + i * 420}ms`}>
            <code class="ow-name">{m}</code>
            <span class="ow-note">
              untouched · written as <code class="ow-sub">{m} (1)</code>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </figure>
</div>

<style>
  .ow-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  @media (max-width: 760px) { .ow-grid { grid-template-columns: 1fr; } }

  .ow-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--s-3);
    min-height: calc(4 * 44px);
  }
  .ow-row {
    display: flex; flex-direction: column; gap: 1px;
    animation: seq-line 300ms var(--curve) both;
  }
  .ow-name {
    background: none; padding: 0;
    font-family: var(--mono); font-size: 0.82rem;
    color: var(--text-primary); width: fit-content;
  }
  .ow-gone {
    color: var(--accent-critical);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .ow-sub { background: none; padding: 0; color: var(--brand); }
  .ow-note { font-size: var(--fs-caption); color: var(--text-tertiary); }
  .ow-bad { color: var(--accent-critical); }
  .ow-good { color: var(--brand); }
</style>
