---
/**
 * Three platforms, three marks, three links into `/download`.
 *
 * Each goes to that platform's own anchor on the download page rather than to
 * the top of it, so the click lands on the table it was asking about. There is
 * still no OS detection — that needs JavaScript, and every content page here
 * budgets none — so all three are equally prominent and the visitor picks.
 *
 * The marks are drawn, not fetched: three inline paths cost nothing, theme with
 * the page and stay sharp at any scale.
 */
export interface Props {
  title?: string;
  sub?: string;
}
const { title = 'Get OpenConvert', sub = 'Apache-2.0, and every feature is in the free build.' } =
  Astro.props;

const platforms = [
  { id: 'windows', label: 'Windows', hint: 'Windows 10 and 11 · x86-64' },
  { id: 'macos', label: 'macOS', hint: 'Apple Silicon and Intel' },
  { id: 'linux', label: 'Linux', hint: '.deb and AppImage' },
];
---
<div class="pc stack stack-7">
  <div class="stack stack-3 pc-head">
    <h2>{title}</h2>
    <p class="reassure">{sub}</p>
  </div>

  <ul class="pc-grid">
    {platforms.map((p) => (
      <li>
        <a href={`/download#${p.id}`} class="pc-card plain">
          <span class="pc-mark" aria-hidden="true">
            {p.id === 'windows' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M2.4 5.3l7.6-1.05v7.35H2.4V5.3Zm0 13.4l7.6 1.05v-7.26H2.4v6.21Zm8.45 1.16L21.6 21.4V12.4h-10.75v7.46ZM10.85 3.7v7.9H21.6V2.6L10.85 3.7Z" />
              </svg>
            )}
            {p.id === 'macos' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M16.36 12.62c-.02-2.2 1.8-3.26 1.88-3.31-1.02-1.5-2.62-1.7-3.19-1.72-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.87-.76-1.48.02-2.84.86-3.6 2.18-1.53 2.66-.39 6.6 1.1 8.76.73 1.06 1.6 2.25 2.74 2.2 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.7.71 2.86.69 1.18-.02 1.93-1.08 2.65-2.14.83-1.22 1.18-2.41 1.2-2.47-.03-.01-2.3-.88-2.32-3.52ZM14.2 5.9c.6-.74 1.01-1.75.9-2.77-.87.04-1.93.58-2.56 1.31-.56.65-1.05 1.69-.92 2.68.97.08 1.96-.49 2.58-1.22Z" />
              </svg>
            )}
            {p.id === 'linux' && (
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2c-2.2 0-3.6 1.7-3.6 4.1 0 1 .1 1.9.1 2.6 0 .9-.7 1.7-1.5 2.9-1 1.5-2 3-2.4 4.7-.3 1.2-.1 2.1.5 2.6.5.4 1.2.5 1.9.4.3.6.9 1.1 1.7 1.4 1.9.7 4.7.7 6.6 0 .8-.3 1.4-.8 1.7-1.4.7.1 1.4 0 1.9-.4.6-.5.8-1.4.5-2.6-.4-1.7-1.4-3.2-2.4-4.7-.8-1.2-1.5-2-1.5-2.9 0-.7.1-1.6.1-2.6C15.6 3.7 14.2 2 12 2Zm-1.55 3.05c.44 0 .8.5.8 1.1s-.36 1.1-.8 1.1c-.44 0-.8-.5-.8-1.1s.36-1.1.8-1.1Zm3.1 0c.44 0 .8.5.8 1.1s-.36 1.1-.8 1.1c-.44 0-.8-.5-.8-1.1s.36-1.1.8-1.1ZM12 8.3c.9 0 1.9.4 1.9.9 0 .3-.3.5-.7.8-.4.3-.8.6-1.2.6s-.8-.3-1.2-.6c-.4-.3-.7-.5-.7-.8 0-.5 1-.9 1.9-.9Z" />
              </svg>
            )}
          </span>
          <span class="pc-label">{p.label}</span>
          <span class="caption pc-hint">{p.hint}</span>
          <span class="pc-go">Download →</span>
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .pc { align-items: center; text-align: center; }
  .pc-head { align-items: center; }

  .pc-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-4);
    list-style: none; margin: 0; padding: 0;
    width: 100%; max-width: 780px;
  }
  @media (max-width: 720px) { .pc-grid { grid-template-columns: 1fr; } }

  .pc-card {
    display: flex; flex-direction: column; align-items: center; gap: var(--s-2);
    padding: var(--s-6) var(--s-4);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    background: var(--surface-base);
    transition: border-color var(--m-standard) ease-out, transform var(--m-standard) var(--curve);
  }
  .pc-card:hover { border-color: var(--brand-line); transform: translateY(-2px); }
  .pc-mark { color: var(--text-primary); }
  .pc-mark svg { width: 34px; height: 34px; display: block; }
  .pc-label { font-weight: var(--fw-strong); letter-spacing: -0.012em; margin-top: var(--s-2); }
  .pc-hint { min-height: 2.2em; }
  .pc-go {
    margin-top: var(--s-3);
    font-size: 0.82rem; font-weight: var(--fw-strong);
    color: var(--brand);
  }
</style>
