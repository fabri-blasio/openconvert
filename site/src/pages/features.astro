---
/**
 * What it does — for someone deciding whether to install it.
 *
 * The previous version of this page opened with a 126-row route table and a
 * pair of terminal transcripts. That is the reference a user wants on their
 * fourth visit, not the answer they came for on their first, which is always
 * one of four questions: can it do my conversion, what can it do to my kind of
 * file, does the AI cost me anything, and how do I know what it did.
 *
 * So the page is those four, in that order, and the reference lives behind the
 * picker and on /safety where the argument that needs it is made.
 */
import Base from '../layouts/Base.astro';
import Shot from '../components/Shot.astro';
import ToolTabs from '../components/ToolTabs.astro';
import RoutePicker from '../components/RoutePicker.astro';
import Savings from '../components/Savings.astro';
import Receipt from '../components/Receipt.astro';
import PlatformCta from '../components/PlatformCta.astro';
import data from '../data/formats.json';
import models from '../data/models.json';
import toolData from '../data/tools.json';
import { toolGroups } from '../data/tool-groups';

type Fmt = { id: string; kind: string; routes: { to: string }[] };
const formats = data.formats as Fmt[];
const sources = formats.filter((f) => f.routes.length > 0);
const routeCount = sources.reduce((n, f) => n + f.routes.length, 0);

/* The tool count comes out of `all_tools()` via scripts/export-tools.mjs, for
   the same reason the route count comes out of the binary: the page said
   "eleven tools" for as long as the product had eleven, and then it kept
   saying it. `advertised` is the menu; the unlisted descriptors are what the
   workspaces save through and are not tools a person chooses. */
const toolCount = (toolData.tools as { advertised: boolean }[]).filter((t) => t.advertised).length;

/** The optional pack, from the registry CI checks against. */
type Artifact = {
  name: string; version: string; licence: string;
  /** The model card, or null when the pinned URL's shape was not recognised. */
  href: string | null; host: string | null;
};
type Feature = {
  id: string; title: string; does: string;
  models: string[]; artifacts: Artifact[];
  size: string; licence: string; usable: boolean;
};
const pack = (models.features as Feature[]).filter((f) => f.usable);
const modelGroups = [
  {
    id: 'image',
    title: 'Image models',
    items: pack.filter((f) =>
      f.id.startsWith('remove-background') || f.id === 'upscale' || f.id === 'ocr'),
  },
  {
    id: 'audio',
    title: 'Audio models',
    items: pack.filter((f) => f.id === 'denoise' || f.id === 'transcribe'),
  },
];

/* The receipt, in the four lines a person actually wants from it. */
const receiptFields = [
  { k: 'What ran', v: 'The engine and its exact version: oc-images, libheif 1.17.6' },
  { k: 'What it did to the file', v: 'Lossless, lossy, rebuilt or generated.' },
  { k: 'What it was allowed to do', v: 'The sandbox that actually engaged, and the memory and time limits' },
  { k: 'What it read', v: 'A hash of the exact bytes, so the input can be identified later' },
  { k: 'What it sent', v: 'The number of network calls. It is zero.' },
];
---
<Base
  title="Features — OpenConvert"
  description="Every conversion OpenConvert can make, the tools for images, documents, audio and video, the optional on-device models, and the receipt every job writes."
  path="/features">

  <!-- ══════════ 1 · HERO ══════════ -->
  <section class="f-head">
    <div class="wrap stack stack-5 f-head-inner">
      <h1 class="hero-title">Everything it does.</h1>
      <p class="lede hero-lede">
        {routeCount} conversions, {toolCount} tools, optional AI models; all of
        it on your machine, and every job accounted for.
      </p>
    </div>
  </section>

  <!-- ══════════ 2 · THE PICKER ══════════ -->
  <section class="band" id="conversions">
    <div class="wrap stack stack-6">
      <div class="sec-head stack stack-3">
        <h2>Can it do what you need?</h2>
        <p class="lede">Pick your starting filetype. Everything it can become is on the right.</p>
      </div>
      <RoutePicker />
    </div>
  </section>

  <!-- ══════════ 3 · BY FILE TYPE ══════════ -->
  <section id="tools">
    <div class="wrap stack stack-7">
      <div class="sec-head stack stack-3">
        <h2>The tools we built in.</h2>
        <p class="lede">
          OpenConvert is more than a converter. It is meant to replace every web
          search you have ever run about your own files.
        </p>
      </div>
      <ToolTabs groups={toolGroups} />
    </div>
  </section>

  <!-- ══════════ 4 · THE MODELS ══════════ -->
  <section class="band" id="ai">
    <div class="wrap stack stack-7">
      <div class="sec-head stack stack-3">
        <h2>The Local AI Models.</h2>
        <p class="lede">
          Optional, off until you download them, and each one shows its size and
          its licence before it is fetched.
        </p>
      </div>

      <div class="models">
        <div class="model-groups">
          {modelGroups.map((group, i) => (
            <details class="model-group" open={i === 0}>
              <summary>
                <span>{group.title}</span>
                <span class="caption">{group.items.length} options</span>
              </summary>
              <ul class="model-list">
                {group.items.map((f) => (
                  <li class="model">
                    <div class="m-top">
                      <span class="m-title">{f.title}</span>
                      <span class="m-size caption">{f.size}</span>
                    </div>
                    <p class="small m-does">{f.does}</p>
                    <p class="caption m-meta">
                      {f.artifacts.map((a, artifactIndex) => (
                        <>
                          {artifactIndex > 0 && ' · '}
                          {a.href
                            ? <a href={a.href} rel="noopener">{a.name}</a>
                            : <span>{a.name}</span>}
                          {' '}{a.version}
                        </>
                      ))}
                      {' — '}{f.licence}
                    </p>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>

        <div class="m-shot">
          <Shot id="ai-features" alt="The OpenConvert first-run panel offering four optional models, none installed." />
          <p class="caption">
            Nothing is installed until this is answered, and the download is the
            only moment anything is fetched. <a href="/licences">Every model's licence →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 5 · WHAT IT SAVES ══════════ -->
  <section id="cost">
    <div class="wrap stack stack-6">
      <div class="sec-head stack stack-3">
        <h2>The $ you save.</h2>
        <p class="lede">
          Background removal and file conversion are metered almost everywhere
          else. With OpenConvert they are free, for good.
        </p>
      </div>
      <Savings />
    </div>
  </section>

  <!-- ══════════ 6 · RECEIPTS ══════════ -->
  <section class="band" id="receipts">
    <div class="wrap">
      <div class="receipt-split">
        <div class="stack stack-5 r-copy">
          <span class="eyebrow">receipts</span>
          <h2>Every job leaves a note.</h2>
          <p class="lede">
            Beside every output is a small file saying what happened to yours.
            On for every conversion, and switchable off in settings.
          </p>
          <dl class="fields">
            {receiptFields.map((f) => (
              <>
                <dt>{f.k}</dt>
                <dd>{f.v}</dd>
              </>
            ))}
          </dl>
          <p><a href="/safety">How the confinement it records actually works →</a></p>
        </div>
        <div class="receipt-example">
          <Shot id="receipt-open" alt="A receipt expanded in OpenConvert, listing engine, class, limits, hashes and network calls." />
          <details class="receipt-json">
            <summary>Example receipt JSON</summary>
            <Receipt />
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════ 7 · GET IT ══════════ -->
  <section>
    <div class="wrap">
      <PlatformCta />
    </div>
  </section>
</Base>

<style>
  section { border-top: 0; }

  .f-head { padding-block: clamp(var(--s-7), 6vw, var(--s-9)) var(--s-8); }
  .f-head-inner { align-items: center; text-align: center; }
  .f-head-inner .hero-lede { max-width: 54ch; }

  .sec-head { text-align: center; align-items: center; }
  .sec-head h2 { font-size: clamp(1.7rem, 3.4vw, 2.4rem); letter-spacing: -0.028em; }
  .sec-head .lede { max-width: 56ch; }
  #tools .wrap, #ai .wrap { max-width: min(94vw, 1140px); }

  /* ---- models ---- */
  .models {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
    gap: clamp(var(--s-6), 5vw, var(--s-8));
    align-items: center;
  }
  @media (max-width: 900px) { .models { grid-template-columns: 1fr; } }

  .model-groups {
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface-base);
  }
  .model-group + .model-group { border-top: 1px solid var(--hairline); }
  .model-group summary {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-4);
    padding: var(--s-5);
    cursor: pointer;
    font-weight: var(--fw-strong);
    list-style: none;
  }
  .model-group summary::-webkit-details-marker { display: none; }
  .model-group summary::after { content: '⌄'; color: var(--text-tertiary); }
  .model-group[open] summary::after { rotate: 180deg; }
  .model-group summary:hover { color: var(--brand); }
  .model-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1px;
    background: var(--hairline);
    border-top: 1px solid var(--hairline);
  }
  .model { padding: var(--s-4) var(--s-5); background: var(--surface-base); }
  .m-top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); }
  .m-title { font-weight: var(--fw-strong); letter-spacing: -0.012em; }
  .m-does { color: var(--text-secondary); margin-top: 2px; }
  .m-meta { margin-top: 4px; }
  .m-shot { display: grid; gap: var(--s-3); }

  /* ---- receipts ---- */
  .receipt-split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(var(--s-6), 5vw, var(--s-8));
    align-items: center;
  }
  @media (max-width: 900px) { .receipt-split { grid-template-columns: 1fr; } }
  .r-copy { max-width: 48ch; }
  .receipt-example { display: grid; gap: var(--s-4); min-width: 0; }
  .receipt-json {
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--surface-base);
  }
  .receipt-json > summary {
    padding: var(--s-4) var(--s-5);
    cursor: pointer;
    font-weight: var(--fw-strong);
  }
  .receipt-json > :global(.rp) { margin: 0; border: 0; border-top: 1px solid var(--hairline); border-radius: 0; }

  .fields { margin: 0; display: grid; gap: var(--s-3); }
  .fields dt {
    font-weight: var(--fw-strong);
    font-size: var(--fs-small);
    letter-spacing: -0.01em;
  }
  .fields dd {
    margin: 2px 0 0;
    font-size: var(--fs-small);
    color: var(--text-secondary);
  }
</style>
